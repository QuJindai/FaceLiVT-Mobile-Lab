<resources>
    <style name="Theme.FaceLiVTLab" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorAccent">#1AAE98</item>
    </style>

    <style name="Widget.FaceLiVTLab.Button.Primary" parent="Widget.AppCompat.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/lab_primary_text</item>
        <item name="android:backgroundTint">@color/lab_primary_bg</item>
    </style>

    <style name="Widget.FaceLiVTLab.Button.Secondary" parent="Widget.AppCompat.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/lab_secondary_text</item>
        <item name="android:backgroundTint">@color/lab_secondary_bg</item>
    </style>

    <style name="Widget.FaceLiVTLab.Spinner" parent="Widget.AppCompat.Spinner">
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:paddingRight">4dp</item>
        <item name="android:backgroundTint">#D4E0DD</item>
        <item name="android:popupBackground">#FAFAFA</item>
    </style>
</resources>
