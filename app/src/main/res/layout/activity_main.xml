<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:padding="10dp"
        android:background="#AA000000">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="R2 初始化中"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtMetrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="等待相机"
                android:textColor="#E6FFFFFF"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/txtPerf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="性能/温度等待中"
                android:textColor="#E6FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/imgDegraded"
            android:layout_width="112dp"
            android:layout_height="76dp"
            android:layout_marginStart="6dp"
            android:background="#33000000"
            android:contentDescription="模型实际看到的降质画面"
            android:scaleType="centerCrop" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="10dp"
        android:background="#DD111111">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="虚拟廉价摄像头 · R2"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/spinnerProfile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <Spinner
                android:id="@+id/spinnerModel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtThreshold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="识别阈值 0.45"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/seekThreshold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="42" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/editName"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="姓名/编号"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#99FFFFFF" />

            <Button
                android:id="@+id/btnEnroll"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="三模型录入×5" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSwitch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="切相机" />

            <Button
                android:id="@+id/btnExport"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="导出 CSV" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
